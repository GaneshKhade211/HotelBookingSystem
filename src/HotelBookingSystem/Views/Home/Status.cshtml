@model int
@{
    var (title, message) = Model switch
    {
        404 => ("Page not found", "The page you are looking for does not exist or may have been moved."),
        400 => ("Bad request", "The request could not be processed. Please go back and try again."),
        403 => ("Access denied", "You do not have permission to view this page."),
        _ => ("Something went wrong", "Please try again in a moment.")
    };
    ViewData["Title"] = title;
}

<div class="text-center py-5">
    <div class="display-1 fw-bold text-secondary">@Model</div>
    <h1 class="h3 mt-2">@title</h1>
    <p class="text-muted mb-4">@message</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Go to the home page</a>
    <a asp-controller="Rooms" asp-action="Index" class="btn btn-outline-primary ms-2">Browse rooms</a>
</div>