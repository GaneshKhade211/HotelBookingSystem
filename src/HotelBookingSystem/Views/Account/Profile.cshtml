@{
    ViewData["Title"] = "My profile";
    var roles = User.FindAll("role").Select(c => c.Value);
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm mt-4">
            <div class="card-body p-4">
                <h1 class="h3 mb-3">My profile</h1>
                <dl class="row mb-0">
                    <dt class="col-sm-4">Name</dt>
                    <dd class="col-sm-8">@User.Identity?.Name</dd>

                    <dt class="col-sm-4">Email</dt>
                    <dd class="col-sm-8">@User.FindFirst("email")?.Value</dd>

                    <dt class="col-sm-4">Role(s)</dt>
                    <dd class="col-sm-8">@string.Join(", ", roles)</dd>
                </dl>
            </div>
        </div>
    </div>
</div>