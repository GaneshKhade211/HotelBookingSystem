@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="text-center py-5">
    <h1 class="h3">Sorry, something went wrong.</h1>
    <p class="text-muted">An unexpected error occurred while processing your request. Please try again.</p>
    @if (Model?.ShowRequestId ?? false)
    {
        <p class="small text-muted">Reference for support: <code>@Model.RequestId</code></p>
    }
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Go to the home page</a>
</div>