@model HotelBookingSystem.ViewModels.PublicRoomDetailsViewModel
@using HotelBookingSystem.Extensions
@inject TimeProvider Time
@{
    var room = Model.Room;
    ViewData["Title"] = $"{room.RoomTypeName} room {room.RoomNumber}";
    var today = Time.GetHotelToday().ToString("yyyy-MM-dd");
}

<a asp-action="Index" asp-route-checkIn="@Model.Search.CheckIn?.ToString("yyyy-MM-dd")"
   asp-route-checkOut="@Model.Search.CheckOut?.ToString("yyyy-MM-dd")" asp-route-guests="@Model.Search.Guests"
   class="d-inline-block mb-3">&larr; Back to rooms</a>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card shadow-sm">
            @if (!string.IsNullOrEmpty(room.ImageUrl))
            {
                <img src="@room.ImageUrl" alt="@room.RoomTypeName room @room.RoomNumber" class="card-img-top object-fit-cover" style="max-height: 360px;" />
            }
            else
            {
                <div class="bg-light text-muted d-flex align-items-center justify-content-center" style="height: 240px;">No image</div>
            }
            <div class="card-body p-4">
                <h1 class="h3">@room.RoomTypeName <span class="text-muted fs-5">Room @room.RoomNumber</span></h1>
                <p class="text-muted">@room.RoomTypeDescription</p>
                <p>@room.Description</p>

                <dl class="row mb-0">
                    <dt class="col-sm-4">Capacity</dt>
                    <dd class="col-sm-8">Up to @room.Capacity guest(s)</dd>
                    <dt class="col-sm-4">Price</dt>
                    <dd class="col-sm-8">₹@room.PricePerNight.ToString("N2") per night</dd>
                    <dt class="col-sm-4">Amenities</dt>
                    <dd class="col-sm-8">
                        @foreach (var amenity in room.Amenities)
                        {
                            <span class="badge text-bg-light border me-1 mb-1">@amenity</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h2 class="h5 mb-3">Your stay</h2>

                <form asp-action="Details" asp-route-id="@room.RoomId" method="get" class="mb-3" novalidate>
                    <div asp-validation-summary="All" class="text-danger small"></div>
                    <div class="row g-2">
                        <div class="col-6">
                            <label for="CheckIn" class="form-label small">Check-in</label>
                            <input id="CheckIn" name="CheckIn" type="date" class="form-control" min="@today"
                                   value="@Model.Search.CheckIn?.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-6">
                            <label for="CheckOut" class="form-label small">Check-out</label>
                            <input id="CheckOut" name="CheckOut" type="date" class="form-control" min="@today"
                                   value="@Model.Search.CheckOut?.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-6">
                            <label for="Guests" class="form-label small">Guests</label>
                            <input id="Guests" name="Guests" type="number" class="form-control" min="1" max="10"
                                   value="@Model.Search.Guests" />
                        </div>
                        <div class="col-6 d-flex align-items-end">
                            <button type="submit" class="btn btn-outline-primary w-100">Check availability</button>
                        </div>
                    </div>
                </form>

                @if (Model.DatesValid)
                {
                    <ul class="list-unstyled small mb-3">
                        <li>@Model.Search.CheckIn?.ToString("dd MMM yyyy") &rarr; @Model.Search.CheckOut?.ToString("dd MMM yyyy")</li>
                        <li>@Model.Nights night(s), @Model.Search.Guests guest(s)</li>
                        <li class="fs-5 fw-bold mt-1">Total: ₹@Model.TotalPrice.ToString("N2")</li>
                    </ul>

                    @if (!Model.FitsGuests)
                    {
                        <div class="alert alert-warning mb-0">This room fits up to @room.Capacity guest(s).</div>
                    }
                    else if (!Model.IsAvailable)
                    {
                        <div class="alert alert-danger mb-0">Not available for these dates. Please try other dates.</div>
                    }
                    else
                    {
                        <div class="alert alert-success">Available for your dates.</div>
                        <a asp-controller="Bookings" asp-action="Create"
                           asp-route-roomId="@room.RoomId"
                           asp-route-checkIn="@Model.Search.CheckIn?.ToString("yyyy-MM-dd")"
                           asp-route-checkOut="@Model.Search.CheckOut?.ToString("yyyy-MM-dd")"
                           asp-route-guests="@Model.Search.Guests"
                           class="btn btn-primary w-100">Book this room</a>
                    }
                }
                else if (!Model.Search.IsSearch)
                {
                    <p class="text-muted small mb-0">Choose your dates and guests to check availability and see the total price.</p>
                }
            </div>
        </div>
    </div>
</div>