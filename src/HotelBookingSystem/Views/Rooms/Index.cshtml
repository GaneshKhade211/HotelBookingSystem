@model HotelBookingSystem.ViewModels.RoomSearchViewModel
@{
    ViewData["Title"] = Model.IsSearch ? "Available rooms" : "Our rooms";
    var hasErrors = !ViewData.ModelState.IsValid;
}

<h1 class="h3 mb-3">@ViewData["Title"]</h1>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <partial name="_RoomSearchForm" model="Model" />
    </div>
</div>

@if (hasErrors)
{
    <div class="alert alert-warning">Please correct the search details above.</div>
}
else
{
    @if (Model.IsSearch)
    {
        <p class="text-muted">
            @Model.Rooms.Count room(s) available from @Model.CheckIn?.ToString("dd MMM yyyy")
            to @Model.CheckOut?.ToString("dd MMM yyyy") for @Model.Guests guest(s).
        </p>
    }

    @if (Model.Rooms.Count == 0)
    {
        <div class="alert alert-info">
            @(Model.IsSearch
                ? "No rooms are available for these dates and guests. Try different dates or fewer guests."
                : "No rooms are available at the moment.")
</div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var room in Model.Rooms)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">
                        @if (!string.IsNullOrEmpty(room.ImageUrl))
                        {
                            <img src="@room.ImageUrl" alt="@room.RoomTypeName room @room.RoomNumber"
                                 class="card-img-top object-fit-cover" style="height: 180px;" />
                        }
                        else
                        {
                            <div class="bg-light text-muted d-flex align-items-center justify-content-center" style="height: 180px;">
                                No image
                            </div>
                        }
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start">
                                <h2 class="h5 mb-1">@room.RoomTypeName</h2>
                                <span class="text-muted small">Room @room.RoomNumber</span>
                            </div>
                            <p class="small text-muted mb-2">Up to @room.Capacity guest(s)</p>
                            <p class="small flex-grow-1">@room.Description</p>
                            <div class="mb-3">
                                @foreach (var amenity in room.Amenities.Take(4))
                                {
                                    <span class="badge text-bg-light border me-1 mb-1">@amenity</span>
                                }
                                @if (room.Amenities.Count > 4)
                                {
                                    <span class="small text-muted">+@(room.Amenities.Count - 4) more</span>
                                }
                            </div>
                            <div class="d-flex justify-content-between align-items-end">
                                <div>
                                    <div class="fw-bold">₹@room.PricePerNight.ToString("N0") <span class="fw-normal small text-muted">/ night</span></div>
                                    @if (room.Nights > 0)
                                    {
                                        <div class="small text-muted">₹@room.TotalPrice.ToString("N0") for @room.Nights night(s)</div>
                                    }
                                </div>
                                <a asp-action="Details" asp-route-id="@room.RoomId"
                                   asp-route-checkIn="@Model.CheckIn?.ToString("yyyy-MM-dd")"
                                   asp-route-checkOut="@Model.CheckOut?.ToString("yyyy-MM-dd")"
                                   asp-route-guests="@Model.Guests"
                                   class="btn btn-outline-primary btn-sm">View details</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}