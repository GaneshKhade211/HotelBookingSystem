@model List<HotelBookingSystem.ViewModels.RoomListItemViewModel>
@{
    ViewData["Title"] = "Manage rooms";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Manage rooms</h1>
    <a asp-action="Create" class="btn btn-primary">+ Add room</a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">No rooms yet. Click <strong>Add room</strong> to create the first one.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Room</th>
                    <th>Type</th>
                    <th class="text-center">Capacity</th>
                    <th class="text-end">Price / night</th>
                    <th class="text-center">Amenities</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var room in Model)
                {
                    <tr>
                        <td class="fw-semibold">@room.RoomNumber</td>
                        <td>@room.RoomTypeName</td>
                        <td class="text-center">@room.Capacity</td>
                        <td class="text-end">₹@room.PricePerNight.ToString("N2")</td>
                        <td class="text-center">@room.AmenityCount</td>
                        <td>
                            @if (room.IsActive)
                            {
                                <span class="badge text-bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">Inactive</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-id="@room.RoomId" class="btn btn-sm btn-outline-primary">Details</a>
                            <a asp-action="Edit" asp-route-id="@room.RoomId" class="btn btn-sm btn-outline-secondary">Edit</a>
                            <form asp-action="SetActive" asp-route-id="@room.RoomId" method="post" class="d-inline">
                                <input type="hidden" name="isActive" value="@(room.IsActive ? "false" : "true")" />
                                @if (room.IsActive)
                                {
                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                            onclick="return confirm('Deactivate room @room.RoomNumber? It will not accept new bookings.');">
                                        Deactivate
                                    </button>
                                }
                                else
                                {
                                    <button type="submit" class="btn btn-sm btn-outline-success">Activate</button>
                                }
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}