@model HotelBookingSystem.ViewModels.RoomDetailsViewModel
@{
    ViewData["Title"] = $"Room {Model.RoomNumber}";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">
        Room @Model.RoomNumber
        @if (Model.IsActive)
        {
            <span class="badge text-bg-success align-middle fs-6">Active</span>
        }
        else
        {
            <span class="badge text-bg-secondary align-middle fs-6">Inactive</span>
        }
    </h1>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.RoomId" class="btn btn-primary">Edit</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to rooms</a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="row g-0">
        <div class="col-md-5">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" alt="Room @Model.RoomNumber" class="img-fluid rounded-start w-100 h-100 object-fit-cover" />
            }
            else
            {
                <div class="bg-light text-muted d-flex align-items-center justify-content-center h-100 p-5 rounded-start">No image</div>
            }
        </div>
        <div class="col-md-7">
            <div class="card-body p-4">
                <dl class="row mb-0">
                    <dt class="col-sm-5">Type</dt>
                    <dd class="col-sm-7">@Model.RoomTypeName</dd>

                    <dt class="col-sm-5">Capacity</dt>
                    <dd class="col-sm-7">@Model.Capacity guest(s)</dd>

                    <dt class="col-sm-5">Price per night</dt>
                    <dd class="col-sm-7">₹@Model.PricePerNight.ToString("N2")</dd>

                    <dt class="col-sm-5">Upcoming bookings</dt>
                    <dd class="col-sm-7">@Model.UpcomingBookings</dd>

                    <dt class="col-sm-5">Description</dt>
                    <dd class="col-sm-7">@(Model.Description ?? "-")</dd>

                    <dt class="col-sm-5">Amenities</dt>
                    <dd class="col-sm-7">
                        @if (Model.Amenities.Count == 0)
                        {
                            <span class="text-muted">None</span>
                        }
                        @foreach (var amenity in Model.Amenities)
                        {
                            <span class="badge text-bg-light border me-1 mb-1">@amenity</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>
    </div>
</div>